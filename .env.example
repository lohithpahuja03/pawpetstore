# ============================================================
# PAWPETSTORE ENVIRONMENT CONFIGURATION
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pawpetstore?schema=public"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="PawPetStore"
NEXT_PUBLIC_COMPANY_TAGLINE="Everything They Need. Everything You Love."

# Authentication (NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="pawpetstore_super_secret_jwt_and_session_signing_key_change_in_prod_2026"

# Payment Gateways (Architected for clean plug-in)
# Razorpay
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_SECRET_KEY="sk_test_placeholder_secret"

# Email / Contact Notifications (SMTP / Resend placeholder)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@pawpetstore.com"
SMTP_PASS="placeholder_password"
CONTACT_EMAIL_RECIPIENT="support@pawpetstore.com"
